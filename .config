# Per-(algo, mode, P) weight_decay for the modular-addition task.
#
# Format:   <algo>.<mode>.<P> = <weight_decay>
#   algo  : gradient | cmaes | cpso | de | g3pcx | moea
#   mode  : grokking (low weight decay) | comprehension (high weight decay)
#   P     : the modulus passed via --P
#
# Lookup order in train.py: an exact <algo>.<mode>.<P> entry wins; otherwise the
# default.<mode> fallback below is used. Edit individual rows to retune which
# weight decay induces grokking vs. normal optimization per algorithm.
#
# Current values are uniform (grokking 8e-5, comprehension 1.0) — adjust freely.

# --- fallbacks (used when no exact algo.mode.P row matches) ---
default.grokking = 8e-5
default.comprehension = 1.0

# --- gradient ---
gradient.grokking.3 = 8e-4
gradient.grokking.5 = 8e-4
gradient.grokking.7 = 8e-5
gradient.grokking.11 = 8e-5
gradient.comprehension.3 = 5.0e-1
gradient.comprehension.5 = 5.0e-1
gradient.comprehension.7 = 5.0e-1
gradient.comprehension.11 = 5.0e-1

# --- cmaes ---
cmaes.grokking.3 = 8e-5
cmaes.grokking.5 = 8e-5
cmaes.grokking.7 = 8e-5
cmaes.grokking.11 = 8e-5
cmaes.comprehension.3 = 1.0
cmaes.comprehension.5 = 1.0
cmaes.comprehension.7 = 1.0
cmaes.comprehension.11 = 1.0

# --- cpso ---
cpso.grokking.3 = 8e-5
cpso.grokking.5 = 8e-5
cpso.grokking.7 = 8e-5
cpso.grokking.11 = 8e-5
cpso.comprehension.3 = 2e-1
cpso.comprehension.5 = 2e-1
cpso.comprehension.7 = 2e-1
cpso.comprehension.11 = 2e-1

# --- de ---
de.grokking.3 = 8e-5
de.grokking.5 = 8e-4
de.grokking.7 = 8e-4
de.grokking.11 = 8e-4
de.comprehension.3 = 1.0
de.comprehension.5 = 1.0
de.comprehension.7 = 1.0
de.comprehension.11 = 1.0

# --- g3pcx ---
g3pcx.grokking.3 = 8e-5
g3pcx.grokking.5 = 8e-5
g3pcx.grokking.7 = 8e-5
g3pcx.grokking.11 = 8e-5
g3pcx.comprehension.3 = 1.0
g3pcx.comprehension.5 = 1.0
g3pcx.comprehension.7 = 1.0
g3pcx.comprehension.11 = 1.0

# --- moea ---
moea.grokking.3 = 8e-4
moea.grokking.5 = 8e-4
moea.grokking.7 = 8e-4
moea.grokking.11 = 8e-4
moea.comprehension.3 = 5.0
moea.comprehension.5 = 5.0
moea.comprehension.7 = 5.0
moea.comprehension.11 = 5.0